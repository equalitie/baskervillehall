          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT d.host AS site, coalesce((d.profile->'incidents'->>'n_30d')::int, 0) AS \"incidents 30 d\",\n       (d.profile->'traffic'->>'req_per_hour_p50')::numeric AS \"req/h p50\"\nFROM site_dossier d\nWHERE d.group_id = (SELECT group_id FROM site_dossier WHERE host = ${host:sqlstring}) AND d.host <> ${host:sqlstring}\nORDER BY 2 DESC, 1",
          "refId": "A"
