    {
      "id": 13,
      "type": "table",
      "title": "Dossier facts",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PCC52D03280B7034C"
      },
      "gridPos": {
        "x": 18,
        "y": 13,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PCC52D03280B7034C"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT k AS fact, v AS value FROM (VALUES\n  ('group', coalesce((SELECT group_id FROM site_dossier WHERE host = ${host:sqlstring}), '—')),\n  ('dnet', coalesce((SELECT string_agg(d, ', ') FROM jsonb_array_elements_text((SELECT profile FROM site_dossier WHERE host = ${host:sqlstring})->'dnet') d), '—')),\n  ('peak hour UTC', (SELECT profile FROM site_dossier WHERE host = ${host:sqlstring})->'traffic'->>'peak_hour_utc'),\n  ('quiet hour UTC', (SELECT profile FROM site_dossier WHERE host = ${host:sqlstring})->'traffic'->>'quiet_hour_utc'),\n  ('traffic seen since', (SELECT profile FROM site_dossier WHERE host = ${host:sqlstring})->'traffic'->>'since'),\n  ('baseline req/min (p50)', (SELECT profile FROM site_dossier WHERE host = ${host:sqlstring})->'incidents'->>'baseline_req_min_p50'),\n  ('last incident', (SELECT profile FROM site_dossier WHERE host = ${host:sqlstring})->'incidents'->>'last'),\n  ('exposed files 7 d', coalesce((SELECT profile FROM site_dossier WHERE host = ${host:sqlstring})->>'exposures_7d', '0')),\n  ('SQLi attempts 7 d', coalesce((SELECT profile FROM site_dossier WHERE host = ${host:sqlstring})->>'sqli_7d', '0')),\n  ('dossier version', (SELECT version || ' (' || to_char(updated_at, 'YYYY-MM-DD HH24:MI') || ' UTC, ' || updated_by || ')'\n                       FROM site_dossier WHERE host = ${host:sqlstring}))\n) t(k, v)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "inspect": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "fact"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
