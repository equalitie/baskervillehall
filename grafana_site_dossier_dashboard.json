          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT to_timestamp(epoch_hour * 3600) AS time, sum(count) AS requests\nFROM host_hourly_traffic\nWHERE regexp_replace(lower(host), '^www\\.', '') = ${host:sqlstring} AND epoch_hour * 3600 BETWEEN $__unixEpochFrom() AND $__unixEpochTo()\nGROUP BY 1 ORDER BY 1",
