      "Bash(kubectl set:*)",
      "Bash(kubectl cp:*)",
      "Bash(kubectl create:*)",
      "Bash(kubectl replace:*)",
      "Bash(kubectl label:*)",
      "Bash(kubectl annotate:*)",
      "Bash(kubectl port-forward:*)"
